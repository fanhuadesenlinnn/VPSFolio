{
  "manifest_version": 3,
  "name": "VPSFolio - VPS Traffic Manager",
  "short_name": "VPSFolio",
  "description": "Read-only VPS traffic dashboard for GreenCloud VirtFusion and BandwagonHost KiwiVM, with encrypted Google Drive backup.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "identity"],
  "host_permissions": [
    "https://cp.green.cloud/*",
    "https://api.64clouds.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "VPSFolio", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_page": "dashboard.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "oauth2": {
    "client_id": "000000000000-REPLACE_WITH_YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
  }
}
